{
  "name": "opencollective-images",
  "version": "2.2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/opencollective/opencollective-images.git"
  },
  "jest": {
    "testPathIgnorePatterns": [
      "opencollective-api/"
    ]
  },
  "private": true,
  "engines": {
    "node": "24.x",
    "npm": "11.x"
  },
  "dependencies": {
    "@apollo/client": "^4.0.0",
    "@hyperwatch/hyperwatch": "5.3.3",
    "debug": "4.4.3",
    "dotenv": "18.0.8",
    "express": "5.3.0",
    "express-basic-auth": "1.2.1",
    "express-winston": "4.2.0",
    "graphql": "17.0.2",
    "graphql-tag": "2.12.7",
    "image-size": "2.0.4",
    "lodash": "4.18.1",
    "lru-cache": "11.5.3",
    "mime-types": "3.0.2",
    "node-fetch": "2.7.0",
    "p-limit": "7.3.3",
    "redis": "6.3.0",
    "request-filtering-agent": "3.2.1",
    "rxjs": "7.8.2",
    "sharp": "0.35.5",
    "winston": "3.19.0"
  },
  "scripts": {
    "start": "NODE_ENV=production node dist/server",
    "dev": "nodemon src/server/index.ts -x \"babel-node --extensions .js,.ts\" . -e js,ts --ignore 'test/'",
    "build": "npm run build:clean && npm run build:server",
    "build:clean": "rm -rf dist",
    "build:server": "babel --copy-files --extensions .js,.ts src --out-dir dist",
    "test": "npm run test:server",
    "test:watch": "npm run test:server -- --watch",
    "test:server": "TZ=UTC jest test/server/*",
    "type:check": "tsc",
    "lint": "eslint \"src\" \"test\"",
    "lint:fix": "npm run lint -- --fix",
    "lint:quiet": "npm run lint -- --quiet",
    "pretest": "npm run lint:quiet && npm run prettier:check",
    "commit": "git-cz",
    "prettier": "prettier \"src/**/*.{js,ts}\" \"test/**/*.{js,ts}\"",
    "prettier:write": "npm run prettier -- --write",
    "prettier:check": "npm run prettier -- --list-different",
    "deploy:production": "./scripts/pre-deploy.sh production",
    "deploy:staging": "./scripts/pre-deploy.sh staging",
    "graphql:update:local": "cp ../frontend/lib/graphql/*.graphql src/graphql/ && prettier src/graphql/*.graphql --write",
    "graphql:update": "npm-run-all graphql:updateV1 graphql:updateV2",
    "graphql:updateV1": "curl https://raw.githubusercontent.com/opencollective/opencollective-frontend/main/lib/graphql/schema.graphql --output src/graphql/schema.graphql && prettier src/graphql/schema.graphql --write",
    "graphql:updateV2": "curl https://raw.githubusercontent.com/opencollective/opencollective-frontend/main/lib/graphql/schemaV2.graphql --output src/graphql/schemaV2.graphql && prettier src/graphql/schemaV2.graphql --write",
    "prepare": "husky",
    "depcheck": "npx @opencollective/depcheck ."
  },
  "devDependencies": {
    "@babel/cli": "^8.0.0",
    "@babel/core": "^8.0.0",
    "@babel/node": "^8.0.0",
    "@babel/plugin-transform-typescript": "^8.0.0",
    "@babel/preset-env": "^8.0.0",
    "@eslint/js": "^10.0.0",
    "@graphql-eslint/eslint-plugin": "^4.4.1",
    "@types/debug": "^4.1.13",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.17.27",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^24.0.0",
    "@types/node-fetch": "^2.6.13",
    "@typescript-eslint/parser": "^8.30.1",
    "commitizen": "^4.3.2",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^10.0.0",
    "eslint-config-opencollective": "^7.0.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-n": "^18.0.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.0.0",
    "husky": "^9.1.7",
    "jest": "^30.0.0",
    "lint-staged": "^17.0.0",
    "nodemon": "^3.0.1",
    "npm-run-all2": "^9.0.0",
    "prettier": "^3.1.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.30.1"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "nodemonConfig": {
    "watch": [
      "src/server"
    ]
  },
  "lint-staged": {
    "*.{js,ts}": [
      "prettier --write"
    ]
  },
  "@opencollective/depcheck": {
    "ignoreDirs": [
      "dist"
    ],
    "specials": [
      "babel",
      "bin",
      "eslint",
      "husky",
      "lint-staged",
      "typescript",
      "jest"
    ],
    "ignores": [
      "jest",
      "jest-junit",
      "typescript",
      "@babel/node",
      "@typescript-eslint/parser",
      "@graphql-eslint/eslint-plugin",
      "eslint-import-resolver-typescript",
      "@types/jest",
      "cz-conventional-changelog"
    ]
  }
}
